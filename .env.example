# StockApp V12 — example environment. Copy to `.env` and fill in locally.
# Never commit a real `.env`. All values below are placeholders.

# --- Runtime mode ---
V12_ENV=dev
V12_MODE=paper_ibkr            # paper_* modes only; live modes are guarded
STOCKAPP_V12_RISK=1            # 1 = V12 risk sizing (default), 0 = legacy sizing
STOCKAPP_V12_ENTRY_ENABLED=0
V12_ENTRY_WIRED=0
V12_PAPER_EQUITY=100000        # simulated paper NAV used for sizing
STOCKAPP_ROOT=/path/to/StockV12-public

# --- Redis (state, halt flags, counters) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

# --- Market data / broker (placeholders) ---
POLYGON_API_KEY=your_polygon_api_key
LONGBRIDGE_APP_KEY=your_longbridge_app_key
LONGBRIDGE_APP_SECRET=your_longbridge_app_secret
LONGBRIDGE_ACCESS_TOKEN=your_longbridge_access_token

# --- Models ---
CHRONOS_MODEL_PATH=/path/to/models/chronos/phase2_v2
CHRONOS_ENSEMBLE_MODEL_PATHS=
CHRONOS_FORECAST_THRESHOLD=
V12_LOAD_CHRONOS=0

# --- Notifications ---
V12_NOTIFIER_BACKEND=log       # log | redis | webhook
V12_NOTIFIER_REDIS_URL=redis://127.0.0.1:6380/0
V12_NOTIFIER_REDIS_CHANNEL=v12:notifications
V12_NOTIFIER_WEBHOOK_URL=
V12_NOTIFIER_WEBHOOK_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
