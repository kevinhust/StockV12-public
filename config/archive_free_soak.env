# Archive-free soak env (sourced by scripts/source_archive_free_env.sh).
# Keep this file free of secrets — only path/flags for NUC cron soak.

# Hard archive-off: ensure_v11_archive_on_path() no-ops (Phase 4 cage).
export STOCKAPP_DISABLE_V11_ARCHIVE=1

# Ops markers (not read by Python; for STATUS / operators)
export STOCKAPP_ARCHIVE_FREE_SOAK=1
export STOCKAPP_ARCHIVE_FREE_SOAK_START=2026-07-26

# NUC Redis (6379 has WSL2 stuck reservation on this host family)
export REDIS_HOST="${REDIS_HOST:-127.0.0.1}"
export REDIS_PORT="${REDIS_PORT:-6380}"
